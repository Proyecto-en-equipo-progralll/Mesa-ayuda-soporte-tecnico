digraph UML {
 graph [label="DIAGRAMA UML DE CLASES — SISTEMA DE MESA DE AYUDA", labelloc=t, fontsize=25, fontname="DejaVu Sans", bgcolor="white", pad="0.5", ranksep="1.15", nodesep="0.65", splines=polyline];
 node [shape=record, style="rounded,filled", fillcolor="#f5f9ff", color="#5275a1", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.12"];
 edge [color="#64748b", penwidth=1.5, fontname="DejaVu Sans", fontsize=10, arrowsize=.8];
 subgraph cluster_estructura { label="1. ESTRUCTURA DE LA INSTITUCIÓN"; color="#9dc5f0"; style="rounded"; fontsize=17; fontname="DejaVu Sans";
 departamento [label="{DEPARTAMENTO|id : entero\lnombre : texto\lubicación : texto\l}"];
 equipo [label="{EQUIPO|id : entero\lcódigo de inventario : texto\ltipo : texto\lmarca : texto\lmodelo : texto\ldepartamento_id : entero\l}"];
 }
 subgraph cluster_atencion { label="2. ATENCIÓN DE FALLAS"; color="#9ad6ba"; style="rounded"; fontsize=17; fontname="DejaVu Sans";
 ticket [fillcolor="#e5f4ed",label="{TICKET / SOLICITUD DE SOPORTE|id : entero\lequipo_id : entero\ldescripción : texto\lprioridad : baja / media / alta\lestado : abierto / en proceso / cerrado\ltécnico_id : entero (opcional)\lfecha de creación : fecha y hora\lfecha de cierre : fecha y hora (opcional)\l|puede_cerrarse(cantidad) : booleano\l}"];
 seguimiento [label="{SEGUIMIENTO|id : entero\lticket_id : entero\lcomentario : texto\lfecha : fecha y hora\l}"];
 }
 subgraph cluster_personal { label="3. PERSONAL Y ACCESO AL SISTEMA"; color="#eac18d"; style="rounded"; fontsize=17; fontname="DejaVu Sans";
 tecnico [label="{TÉCNICO|id : entero\lnombre : texto\lespecialidad : texto\lcorreo : texto\lactivo : sí / no\l}"];
 usuario [label="{USUARIO DEL SISTEMA|id : entero\lnombre de usuario : texto\lcontraseña cifrada : texto\lrol : administrador / técnico\ltécnico_id : entero (opcional)\l}"];
 }
 departamento -> equipo [label="1 departamento / varios equipos", arrowhead=vee];
 equipo -> ticket [label="1 equipo / varios tickets",arrowhead=vee];
 tecnico -> ticket [label="1 técnico / varios tickets",arrowhead=vee];
 ticket -> seguimiento [label="1 ticket / varios seguimientos",arrowhead=vee];
 tecnico -> usuario [label="1 técnico / hasta 1 usuario",arrowhead=vee,style=dashed];
}
