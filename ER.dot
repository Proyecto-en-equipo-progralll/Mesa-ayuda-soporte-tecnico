digraph ER {graph [rankdir=LR,bgcolor="white",fontname="Arial"];node[shape=record,style="filled,rounded",fillcolor="#f4f7fb",color="#35639b",fontname="Arial"];edge[color="#4b5c73"]; departamentos[label="{departamentos|id PK\lnombre UNIQUE\lubicacion\l}"];equipos[label="{equipos|id PK\lcodigo_inventario UNIQUE\ltipo, marca, modelo\ldepartamento_id FK\l}"];tecnicos[label="{tecnicos|id PK\lnombre, especialidad\lcorreo UNIQUE\lactivo\l}"];tickets[label="{tickets|id PK\lequipo_id FK\ltecnico_id FK\ldescripcion, prioridad, estado\lfecha_creacion, fecha_cierre\l}"];seguimientos[label="{seguimientos|id PK\lticket_id FK\lcomentario, fecha\l}"];usuarios[label="{usuarios|id PK\lnombre_usuario UNIQUE\lcontrasena_hash, rol\ltecnico_id FK\l}"];departamentos->equipos[label="1:N"];equipos->tickets[label="1:N"];tecnicos->tickets[label="1:N"];tickets->seguimientos[label="1:N"];tecnicos->usuarios[label="1:0..1"]; }